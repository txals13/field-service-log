# Secrets del Worker: la clau de Cloud Translation hi és en clar.
worker/.dev.vars
worker/.wrangler/
worker/node_modules/

# La clau privada que signa les llicències. Si aquesta surt del teu ordinador,
# qualsevol pot emetre llicències del Field Service Log.
tools/*.json
fsl-clau-privada.json

# Els servidors de desenvolupament: hi ha els camins de les carpetes d'aquest
# ordinador, i el repositori és públic. El fitxer es queda al disc.
.claude/launch.json

# El fitxer de treball de les captures del manual (tools/captures.py el fa i
# el treu). No es publica: es una copia de index.html amb un guio a dins.
_shot.html

# Visites de debò, a punt per importar a l'app. Hi ha el nom del client, les
# seves fotos i les referències de la màquina, i aquest repositori és públic:
# el fitxer es queda al disc i no puja mai.
_visites/
